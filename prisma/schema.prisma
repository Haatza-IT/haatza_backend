// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[] @relation("CategoryProducts")
  similarCategoryProducts Product[] @relation("SimilarCategoryProducts")
}

model Product {
  // 1-59 fields in exact requested order
  sellerId                 String?   @map("seller_id") @db.VarChar(100)
  categoryId               String    @map("category_id") @db.VarChar(100)
  productId                String    @id @default(uuid()) @map("product_id") @db.Uuid
  productName              String    @map("product_name") @db.VarChar(255)
  categoryName             String?   @map("category_name") @db.VarChar(150)
  productCoverImage        String?   @map("product_cover_image") @db.Text
  productImages            Json?     @default("[]") @map("product_images")
  sku                      String?   @map("sku") @db.VarChar(100)
  shippingWeight           Decimal?  @map("shipping_weight") @db.Decimal(10, 2)
  brand                    String?   @map("brand") @db.VarChar(150)
  status                   Boolean   @default(true) @map("status")
  productOptions           Json?     @default("[]") @map("product_options")
  price                    Decimal   @map("price") @db.Decimal(12, 2)
  productType              String?   @map("product_type") @db.VarChar(100)
  discount                 Decimal?  @default(0) @map("discount") @db.Decimal(10, 2)
  manageVariants           Boolean   @default(false) @map("manage_variants")
  ribbon                   String?   @map("ribbon") @db.VarChar(100)
  trackInventory           Boolean   @default(true) @map("track_inventory")
  variantPrice             Json?     @default("[]") @map("variant_price")
  productSpecification     Json?     @default("{}") @map("product_specification")
  influencerBranding       Boolean   @default(false) @map("influencer_branding")
  activeAd                 Boolean   @default(false) @map("active_add")
  subcategoryName          String?   @map("subcategory_name") @db.VarChar(150)
  subcategoryId            String?   @map("subcategory_id") @db.VarChar(100)
  haatzaVerified           Boolean   @default(false) @map("haatza_verified")
  promotionalImages        Json?     @default("[]") @map("promotional_images")
  paymentType              String?   @map("payment_type") @db.VarChar(100)
  returnPolicy             String?   @map("return_policy")
  deliveryCharges          Boolean   @default(false) @map("delivery_charges")
  sizeChart                String?   @map("size_chart")
  priorityScore            Int       @default(0) @map("priority_score")
  averageCpc               Decimal   @default(0) @map("average_cpc") @db.Decimal(12, 2)
  reach                    BigInt    @default(0) @map("reach")
  impression               BigInt    @default(0) @map("impression")
  clicks                   BigInt    @default(0) @map("clicks")
  sales                    BigInt    @default(0) @map("sales")
  revenue                  Decimal   @default(0) @map("revenue") @db.Decimal(14, 2)
  sellerPincode            String?   @map("seller_pincode") @db.VarChar(6)
  isGstSeller              Boolean   @default(false) @map("is_gst_seller")
  searchKeyword            String[]  @default([]) @map("search_keyword")
  isSellerEarn             Boolean   @default(false) @map("is_seller_earn")
  sellAndEarnCommission    Int       @default(0) @map("is_sell_and_earn_commission")
  isDomestic               Boolean   @default(true) @map("is_domestic")
  businessState            String?   @map("business_state") @db.VarChar(100)
  businessStateCode        String?   @map("business_state_code") @db.VarChar(20)
  salesTerritoryType       String?   @map("sales_territory_type") @db.VarChar(100)
  businessRegistrationType String?   @map("business_registration_type") @db.VarChar(100)
  gstNo                    String?   @map("gst_no") @db.VarChar(15)
  panNumber                String?   @map("pan_number") @db.VarChar(10)
  codPrice                 Decimal?  @map("cod_price") @db.Decimal(12, 2)
  upi                      String?   @map("upi") @db.VarChar(255)
  mrp                      Decimal?  @map("mrp") @db.Decimal(12, 2)
  onSalePrice              Decimal?  @map("onsale_price") @db.Decimal(12, 2)
  upiPaymentDiscount       Decimal?  @map("upi_payment_discount") @db.Decimal(10, 2)
  campaignId               String?   @map("campaign_id") @db.VarChar(100)
  similarCategoryId        String?   @map("similar_category_id") @db.VarChar(100)
  productHighlights        Json?     @default("[]") @map("product_highlights")
  isHaatzaLite             Boolean   @default(false) @map("is_haatzalite")
  warehouseId              String?   @map("warehouse_id") @db.VarChar(100)
  warehousePincode         String?   @map("warehouse_pincode") @db.VarChar(6)

  // Relationships
  category                 Category    @relation("CategoryProducts", fields: [categoryId], references: [id])
  similarCategory          Category?   @relation("SimilarCategoryProducts", fields: [similarCategoryId], references: [id], onDelete: SetNull)
  seller                   UserMaster? @relation(fields: [sellerId], references: [sellerId], onDelete: SetNull)

  // Indexes for query performance
  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([campaignId])
  @@index([warehouseId])
  @@index([sku])
  @@index([status])
  @@map("products")
}

model UserMaster {
  // A. Basic User Information
  userId           String  @id @default(uuid())
  name             String
  email            String  @unique
  phoneNumber      String  @unique
  password         String
  fcmToken         String?
  referralCode     String  @unique
  referredByCode   String?
  isHaatzaEmployee Boolean @default(false)
  isSeller         Boolean @default(false)
  status           Boolean @default(true)
  isNestExpert     Boolean @default(false)
  isReseller       Boolean @default(false)

  // B. Seller Information
  sellerId            String?   @unique
  sellerAddress1      String?
  sellerAddress2      String?
  city                String?
  state               String?
  country             String?
  pinCode             String?
  sellerPickupAddress String?   @db.Text
  pickupLocationId    String?
  sellerOnboardedAt   DateTime?

  // C. Location Information
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // D. Banking Information
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  accountManager    String?

  // E. Business and Tax Information
  gstin           String?
  companyName     String?
  panNumber       String?
  isGSTRegistered Boolean @default(false)

  // F. Date and Time Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // G. Audit Fields
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  // Relations
  refreshTokens RefreshToken[]
  products      Product[]

  @@map("user_masters")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Audit Fields
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  user UserMaster @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Dashboard {
  Widget_id     String   @id @unique
  Widget_name   String
  Redirected_to String?
  Placement     String?
  Sequence      Int?
  Territory     String?
  Items         String[] @default([])
  Product_Id    String?
  Category_Id   String?

  @@index([Placement])
  @@index([Territory])
  @@index([Sequence])
  @@index([Product_Id])
  @@index([Category_Id])
  @@map("dashboard")
}

model OtpStorage {
  id          String    @id @default(uuid())
  phoneNumber String    @map("phone_number") @db.VarChar(15)
  otpHash     String    @map("otp_hash") @db.VarChar(128)
  otpCode     String?   @map("otp_code") @db.VarChar(255)
  purpose     String    @default("login") @map("purpose") @db.VarChar(50)
  expiresAt   DateTime  @map("expires_at")
  isVerified  Boolean   @default(false) @map("is_verified")
  attempts    Int       @default(0) @map("attempts")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([phoneNumber])
  @@index([phoneNumber, purpose])
  @@index([expiresAt])
  @@map("otp_storage")
}
