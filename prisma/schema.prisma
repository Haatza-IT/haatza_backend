// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Add the Category model below

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserMaster {
  // A. Basic User Information
  userId           String  @id @default(uuid())
  name             String
  email            String  @unique
  phoneNumber      String  @unique
  password         String
  fcmToken         String?
  referralCode     String  @unique
  referredByCode   String?
  isHaatzaEmployee Boolean @default(false)
  isSeller         Boolean @default(false)
  status           Boolean @default(true)
  isNestExpert     Boolean @default(false)
  isReseller       Boolean @default(false)

  // B. Seller Information
  sellerId            String?   @unique
  sellerAddress1      String?
  sellerAddress2      String?
  city                String?
  state               String?
  country             String?
  pinCode             String?
  sellerPickupAddress String?   @db.Text
  pickupLocationId    String?
  sellerOnboardedAt   DateTime?

  // C. Location Information
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // D. Banking Information
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  accountManager    String?

  // E. Business and Tax Information
  gstin           String?
  companyName     String?
  panNumber       String?
  isGSTRegistered Boolean @default(false)

  // F. Date and Time Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // G. Audit Fields
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  // Relations
  refreshTokens RefreshToken[]

  @@map("user_masters")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user UserMaster @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
