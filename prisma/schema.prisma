// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products                Product[] @relation("CategoryProducts")
  similarCategoryProducts Product[] @relation("SimilarCategoryProducts")
}

model Product {
  // A. Product and Seller Information (1-18)
  sellerId                 String?
  categoryId               String
  productId                String    @id @default(uuid()) @map("id")
  productName              String    @map("name")
  categoryName             String?
  productCoverImages       Json?
  sku                      String?
  shippingWeight           Int?
  brand                    String?
  status                   Boolean   @default(true) @map("isActive")
  productOptions           Json?
  price                    Int
  productType              String?
  discount                 Int?      @default(0)
  manageVariants           Boolean   @default(false)
  ribbon                   String?
  trackInventory           Boolean   @default(true)
  variantPrice             Json?

  // B. Product Specifications and Images (19-29)
  productSpecification     Json?
  influencerBranding       Boolean   @default(false)
  activeAd                 Boolean   @default(false)
  subcategoryName          String?
  subcategoryId            String?
  haatzaVerified           Boolean   @default(false)
  promotionalImages        Json?
  paymentType              String?
  returnPolicy             Json?
  deliveryCharges          Boolean   @default(false)
  sizeChart                String?

  // C. Marketing and Analytics (30-36)
  priorityScore            Int       @default(0)
  averageCpc               Int       @default(0)
  reach                    Int       @default(0)
  impression               Int       @default(0)
  clicks                   Int       @default(0)
  sales                    Int       @default(0)
  revenue                  Int       @default(0)

  // D. Seller, GST and Business Information (37-48)
  sellerPincode            String?
  isGstSeller              Boolean   @default(false)
  searchKeyword            Json?
  isSellerEarn             Boolean   @default(false)
  sellAndEarnCommission    Int       @default(0)
  isDomestic               Boolean   @default(true)
  businessState            String?
  businessStateCode        String?
  salesTerritoryType       String?
  businessRegistrationType String?
  gstNo                    String?
  panNumber                String?

  // E. Pricing and Payment Information (49-53)
  codPrice                 Int?
  upi                      Int?
  mrp                      Int?
  onSalePrice              Int?
  upiPaymentDiscount       Int?

  // F. Campaign, Category and Warehouse Information (54-59)
  campaignId               String?
  similarCategoryId        String?
  productHighlights        Json?
  isHaatzaLite             Boolean   @default(false)
  warehouseId              String?
  warehousePincode         String?

  // Preserved Existing Fields
  description              String?
  image                    String?
  stock                    Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relationships
  category                 Category    @relation("CategoryProducts", fields: [categoryId], references: [id])
  similarCategory          Category?   @relation("SimilarCategoryProducts", fields: [similarCategoryId], references: [id], onDelete: SetNull)
  seller                   UserMaster? @relation(fields: [sellerId], references: [sellerId], onDelete: SetNull)

  // Indexes for query performance
  @@index([sellerId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([campaignId])
  @@index([warehouseId])
  @@index([sku])
  @@index([status])
}

model UserMaster {
  // A. Basic User Information
  userId           String  @id @default(uuid())
  name             String
  email            String  @unique
  phoneNumber      String  @unique
  password         String
  fcmToken         String?
  referralCode     String  @unique
  referredByCode   String?
  isHaatzaEmployee Boolean @default(false)
  isSeller         Boolean @default(false)
  status           Boolean @default(true)
  isNestExpert     Boolean @default(false)
  isReseller       Boolean @default(false)

  // B. Seller Information
  sellerId            String?   @unique
  sellerAddress1      String?
  sellerAddress2      String?
  city                String?
  state               String?
  country             String?
  pinCode             String?
  sellerPickupAddress String?   @db.Text
  pickupLocationId    String?
  sellerOnboardedAt   DateTime?

  // C. Location Information
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // D. Banking Information
  bankName          String?
  accountHolderName String?
  accountNumber     String?
  ifscCode          String?
  accountManager    String?

  // E. Business and Tax Information
  gstin           String?
  companyName     String?
  panNumber       String?
  isGSTRegistered Boolean @default(false)

  // F. Date and Time Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // G. Audit Fields
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  // Relations
  refreshTokens RefreshToken[]
  products      Product[]

  @@map("user_masters")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user UserMaster @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Dashboard {
  Widget_id     String   @id @unique
  Widget_name   String
  Redirected_to String?
  Placement     String?
  Sequence      Int?
  Territory     String?
  Items         String[] @default([])
  Product_Id    String?
  Category_Id   String?

  @@index([Placement])
  @@index([Territory])
  @@index([Sequence])
  @@index([Product_Id])
  @@index([Category_Id])
  @@map("dashboard")
}
