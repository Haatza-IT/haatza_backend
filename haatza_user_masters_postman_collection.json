                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-admin-key",
                "value": "wrong_key"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isHaatzaEmployee\": true,\n  \"userId\": \"{{registeredUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/haatza_employee",
              "host": ["{{baseUrl}}"],
              "path": ["api", "haatza_employee"]
            }
          }
        },
        {
          "name": "Update Employee Role - Success (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
