                "key": "x-admin-key",
                "value": "{{adminApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isHaatzaEmployee\": true,\n  \"userId\": \"{{registeredUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/haatza_employee",
              "host": ["{{baseUrl}}"],
              "path": ["api", "haatza_employee"]
            }
          }
        }
      ]
